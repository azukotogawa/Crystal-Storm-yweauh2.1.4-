class_name TextureManifest
extends RefCounted
## Scans the project for texture slots and writes docs/texture_manifest.json
## plus docs/TEXTURE_MANIFEST.md. Missing generator art is flagged.

const _SKIP_TEXT := {
	"res://docs/texture_manifest.json": true,
	"res://docs/TEXTURE_MANIFEST.md": true,
}

const _TEXT_EXT := {
	"gd": true, "tscn": true, "tres": true, "cfg": true, "txt": true, "md": true,
}

const _IMAGE_EXT := {
	"png": true, "jpg": true, "jpeg": true, "webp": true, "svg": true,
}

const _CRYSTAL_IDS: PackedStringArray = ["amethyst", "void_shard", "solar_crystal"]
const _BIOME_IDS: PackedStringArray = ["plains", "forest", "marsh", "highland"]
const _ORE_IDS: PackedStringArray = ["iron", "copper", "crystal_ore"]
const _GROUND_IDS: PackedStringArray = ["dirt", "stone", "sand"]


static func write_project() -> Dictionary:
	var doc := build()
	_write_text("res://docs/texture_manifest.json", JSON.stringify(doc, "\t"))
	_write_text("res://docs/TEXTURE_MANIFEST.md", to_markdown(doc))
	return doc


static func build() -> Dictionary:
	var refs := _collect_refs()
	var images: Array = []
	_scan("res://", images, true)
	images.sort()
	var slots: Array = []
	var seen := {}
	for path in images:
		var res_path := str(path)
		if seen.has(res_path):
			continue
		seen[res_path] = true
		var size := _image_size(res_path)
		slots.append(_entry(
			res_path, size.x, size.y, 1.0, 1,
			_refs_for(refs, res_path), _category(res_path), "art"
		))
	var dim := _default_tex_size()
	var crystal_where: Array = [
		"script:res://systems/crystal_texture_generator.gd",
		"script:res://config/crystal_texture_gen_config.gd",
	]
	for id in _CRYSTAL_IDS:
		var missing_path := "res://assets/art/crystal/%s.png" % id
		if not seen.has(missing_path) and classify_art(missing_path) == "missing":
			slots.append(_entry(missing_path, dim, dim, 1.0, 1, crystal_where, "effects", "missing"))
			seen[missing_path] = true
	for path in refs.keys():
		var res_path := str(path)
		if seen.has(res_path) or res_path.contains("%"):
			continue
		if classify_art(res_path) != "missing":
			continue
		slots.append(_entry(
			res_path, 0, 0, 1.0, 1,
			_refs_for(refs, res_path), _category(res_path), "missing"
		))
		seen[res_path] = true
	for id in _CRYSTAL_IDS:
		slots.append(_entry(
			"runtime://generated/crystal/%s" % id, dim, dim, 1.0, 1,
			["script:res://systems/crystal_texture_generator.gd"], "effects", "placeholder"
		))
	for id in _BIOME_IDS:
		slots.append(_entry(
			"runtime://generated/biome/%s" % id, dim, dim, 1.0, 1,
			["script:res://config/crystal_texture_gen_config.gd"], "terrain", "placeholder"
		))
	for id in _ORE_IDS:
		slots.append(_entry(
			"runtime://generated/ore/%s" % id, dim, dim, 1.0, 1,
			["script:res://config/crystal_texture_gen_config.gd"], "terrain", "placeholder"
		))
	for id in _GROUND_IDS:
		slots.append(_entry(
			"runtime://generated/ground/%s" % id, dim, dim, 1.0, 1,
			["script:res://config/crystal_texture_gen_config.gd"], "terrain", "placeholder"
		))
	_add_corrupted_slots(slots, seen)
	slots.sort_custom(func(a, b): return str(a.get("path", "")) < str(b.get("path", "")))
	for i in slots.size():
		var slot: Dictionary = slots[i]
		slot["batch1"] = _batch1_record(str(slot.get("path", "")))
		slots[i] = slot
	var art_n := 0
	var missing_n := 0
	var placeholder_n := 0
	for slot in slots:
		match str(slot.get("art", "")):
			"art":
				art_n += 1
			"missing":
				missing_n += 1
			"placeholder":
				placeholder_n += 1
	return {
		"slot_count": slots.size(),
		"art_count": art_n,
		"missing_count": missing_n,
		"placeholder_count": placeholder_n,
		"slots": slots,
	}


static func to_markdown(doc: Dictionary) -> String:
	var lines: PackedStringArray = []
	lines.append("# Texture manifest")
	lines.append("")
	lines.append("Slots: %d. With art: %d. Missing: %d. Placeholder: %d." % [
		int(doc.get("slot_count", 0)),
		int(doc.get("art_count", 0)),
		int(doc.get("missing_count", 0)),
		int(doc.get("placeholder_count", 0)),
	])
	lines.append("")
	lines.append("Generated by `tools/export_texture_manifest.gd`. Animation frames are 1 unless a real sheet is authored. Scale is 1 when the slot is not a live node.")
	lines.append("")
	lines.append("| path | expected size | scale | frames | category | art | batch1 | appears in |")
	lines.append("| --- | --- | --- | --- | --- | --- | --- | --- |")
	for slot in doc.get("slots", []):
		var size: Array = slot.get("expected_size", [0, 0])
		var w := int(size[0]) if size.size() > 0 else 0
		var h := int(size[1]) if size.size() > 1 else 0
		var appears: Array = slot.get("appears_in", [])
		var where := ""
		for item in appears:
			if not where.is_empty():
				where += ", "
			where += str(item).replace("|", "/")
		var batch: Dictionary = slot.get("batch1", {})
		var batch_size: Array = batch.get("size", [0, 0])
		var bw := int(batch_size[0]) if batch_size.size() > 0 else 0
		var bh := int(batch_size[1]) if batch_size.size() > 1 else 0
		var batch_text := str(batch.get("status", "absent"))
		if batch_text == "present":
			batch_text = "present %dx%d" % [bw, bh]
		lines.append("| %s | %dx%d | %s | %s | %s | %s | %s | %s |" % [
			str(slot.get("path", "")).replace("|", "/"),
			w, h,
			str(slot.get("scale", 1.0)),
			str(slot.get("animation_frames", 1)),
			str(slot.get("category", "")),
			str(slot.get("art", "")),
			batch_text,
			where,
		])
	lines.append("")
	return "\n".join(lines)


static func classify_art(res_path: String) -> String:
	if str(res_path).begins_with("runtime://"):
		return "placeholder"
	if _exists(res_path):
		return "art"
	return "missing"


## Batch 1 mirror of an assets/art slot, or the file itself when the slot already lives in art_batch1.
static func _batch1_record(path: String) -> Dictionary:
	if path.begins_with("res://assets/art_batch1/"):
		var own := _image_size(path)
		return {"status": "present", "size": [own.x, own.y]}
	var mirror := ""
	if path.begins_with("res://assets/art/"):
		mirror = "res://assets/art_batch1/" + path.substr("res://assets/art/".length())
	if mirror.is_empty() or not _exists(mirror):
		return {"status": "absent", "size": [0, 0]}
	var size := _image_size(mirror)
	return {"status": "present", "size": [size.x, size.y]}


## Corrupted vegetation is batch-only art. It is a slot of its own, not a second copy of the healthy plant.
static func _add_corrupted_slots(slots: Array, seen: Dictionary) -> void:
	var dir_path := "res://assets/art_batch1/vegetation"
	var dir := DirAccess.open(dir_path)
	if dir == null:
		return
	var names: Array[String] = []
	for file_name in dir.get_files():
		var low := str(file_name).to_lower()
		if low.begins_with("corrupted_") and low.ends_with(".png"):
			names.append(str(file_name))
	names.sort()
	for file_name in names:
		var res_path := dir_path.path_join(file_name)
		if seen.has(res_path):
			continue
		seen[res_path] = true
		var size := _image_size(res_path)
		slots.append(_entry(res_path, size.x, size.y, 1.0, 1, [], "vegetation", "art"))


static func _entry(
	path: String,
	w: int,
	h: int,
	scale: float,
	frames: int,
	appears_in: Array,
	category: String,
	art: String
) -> Dictionary:
	var where: Array = []
	for item in appears_in:
		if where.size() >= 8:
			break
		where.append(str(item))
	return {
		"path": path,
		"expected_size": [w, h],
		"scale": scale,
		"animation_frames": frames,
		"appears_in": where,
		"category": category,
		"art": art,
	}


static func _refs_for(refs: Dictionary, path: String) -> Array:
	var found = refs.get(path, [])
	if found is Array:
		return found
	return []


static func _category(path: String) -> String:
	var low := path.to_lower()
	if low.contains("/tiles/") or low.ends_with("/cube.png") or low.contains("atlas"):
		return "terrain"
	if low.contains("/vegetation/") or low.contains("plant"):
		return "vegetation"
	if low.contains("/entity/") or low.ends_with("/player.png"):
		return "mobs"
	if low.contains("/items/") or low.contains("/structures/") or low.contains("/building/"):
		return "items"
	if low.contains("/particle/") or low.contains("/vfx/") or low.contains("shadow"):
		return "effects"
	if low.contains("/crystal/"):
		return "effects"
	if low.contains("/ui/") or low.contains("/theme/"):
		return "ui"
	return "ui"


static func _default_tex_size() -> int:
	var script = load("res://config/crystal_texture_gen_config.gd")
	if script == null:
		return 64
	var cfg = script.new()
	if cfg == null:
		return 64
	return maxi(int(cfg.default_texture_size), 1)


static func _image_size(res_path: String) -> Vector2i:
	var abs_path := ProjectSettings.globalize_path(res_path)
	var img := Image.load_from_file(abs_path)
	if img != null and not img.is_empty():
		return Vector2i(img.get_width(), img.get_height())
	if ResourceLoader.exists(res_path):
		var tex := load(res_path) as Texture2D
		if tex != null:
			return Vector2i(tex.get_width(), tex.get_height())
	return Vector2i.ZERO


static func _exists(res_path: String) -> bool:
	if FileAccess.file_exists(res_path):
		return true
	if ResourceLoader.exists(res_path):
		return true
	return FileAccess.file_exists(ProjectSettings.globalize_path(res_path))


static func _collect_refs() -> Dictionary:
	var refs := {}
	var files: Array = []
	_scan("res://", files, false)
	var re := RegEx.new()
	if re.compile("res://[^\\s\"'`\\]\\)]+\\.(?:png|jpg|jpeg|webp|svg)") != OK:
		return refs
	for path in files:
		var res_path := str(path)
		if _SKIP_TEXT.has(res_path):
			continue
		var text := FileAccess.get_file_as_string(res_path)
		if text.is_empty():
			continue
		for line in text.split("\n"):
			if str(line).contains("%s"):
				continue
			for match in re.search_all(line):
				var found := match.get_string()
				if not refs.has(found):
					refs[found] = []
				var bucket: Array = refs[found]
				var where := _where(res_path)
				if bucket.size() < 8 and not bucket.has(where):
					bucket.append(where)
	return refs


static func _where(path: String) -> String:
	var ext := path.get_extension().to_lower()
	var kind := "doc"
	if ext == "gd":
		kind = "script"
	elif ext == "tscn":
		kind = "scene"
	elif ext == "tres":
		kind = "resource"
	elif ext == "cfg":
		kind = "config"
	return "%s:%s" % [kind, path]


static func _scan(path: String, out: Array, images: bool) -> void:
	var dir := DirAccess.open(path)
	if dir == null:
		return
	for name in dir.get_directories():
		if str(name).begins_with(".") or str(name) == "venv" or str(name) == "art_batch1":
			continue
		_scan(path.path_join(str(name)), out, images)
	for name in dir.get_files():
		var ext := str(name).get_extension().to_lower()
		var include := false
		if images:
			include = _IMAGE_EXT.has(ext)
		else:
			include = _TEXT_EXT.has(ext)
		if include:
			out.append(path.path_join(str(name)))


static func _write_text(res_path: String, text: String) -> void:
	var abs_path := ProjectSettings.globalize_path(res_path)
	DirAccess.make_dir_recursive_absolute(abs_path.get_base_dir())
	var f := FileAccess.open(abs_path, FileAccess.WRITE)
	if f == null:
		push_error("Texture manifest could not write %s" % res_path)
		return
	f.store_string(text)
	f.close()
