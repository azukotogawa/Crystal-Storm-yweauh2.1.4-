; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Crystalstorm"
config/version="0.2.8"
run/main_scene="res://scenes/frontend.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://tamt6vl1r5pg"

[autoload]

MainThreadFrameProbe="*res://systems/main_thread_frame_probe.gd"
CrystalTextureGenerator="*res://systems/crystal_texture_generator.gd"
PerfProfiler="*res://systems/perf_profiler.gd"
FrameBudgetScheduler="*res://systems/frame_budget_scheduler.gd"
AudioManager="*res://systems/audio_manager.gd"
TextureBlueprint="*res://systems/texture_blueprint.gd"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/crystal_texture_tools/plugin.cfg")

